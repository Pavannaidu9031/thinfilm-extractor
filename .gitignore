# Secrets & environment files — ignore all .env variants, but KEEP the
# committable *.example templates.
.env
.env.*
!.env.example
!.env.production.example

# Virtual environment
.venv/

# Node
node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local databases (SQLite). Production uses Postgres via DATABASE_URL.
backend/extractions.db
*.sqlite
*.sqlite3

# Build output
web/dist/

# Research-paper PDFs (copyright) and generated demo artifacts — not committed.
# The empty test_papers/ folder is kept via its .gitkeep.
*.pdf
backend/test_papers/*.pdf
chemistry_demo_result.json
extraction_results.json
thin_film_literature_parameters.xlsx
