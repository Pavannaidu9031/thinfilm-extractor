# ── Frontend production environment (Vercel / Netlify) ──────────────────────
# All three are PUBLIC values shipped to the browser — none are secrets.
# (The Gemini key and Postgres string never touch the frontend.)

# Public URL of your deployed backend.
VITE_API_URL=https://your-backend.onrender.com

# Supabase project URL and anon/public key (Supabase → Settings → API).
# The anon key is designed to be public; it only permits what your Supabase
# Row-Level-Security / Auth rules allow. Used here for Google sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
