{
  "name": "thin_film_deposition",
  "display_name": "Thin-film deposition",
  "description": "Literature-tracking table of WO3 (and related) thin-film RF-sputtering deposition parameters and H2-sensing results \u2014 one row per paper.",
  "extraction_context": "You are a materials-science data extraction assistant building a literature-tracking table of thin-film (RF-sputtered metal-oxide) gas-sensor papers. You will be given the full text of one research paper. Produce EXACTLY ONE summary entry for the paper that captures its representative / primary deposition conditions and its headline hydrogen-sensing result. If the paper reports several films or conditions, summarize the main/optimal one and note key variations in Main Finding.",
  "record_label": "entry",
  "unreported_value": "NR",
  "paper_fields": [
    "title",
    "authors",
    "journal",
    "year",
    "doi"
  ],
  "include_other_properties": false,
  "fields": [
    {
      "name": "ref_number",
      "type": "string",
      "nullable": false,
      "description": "Sequential reference number in the literature table (assigned automatically by the reviewer; return NR).",
