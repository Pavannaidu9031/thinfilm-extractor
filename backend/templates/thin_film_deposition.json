    },
    {
      "name": "first_author",
      "type": "string",
      "nullable": false,
      "description": "First author's surname followed by 'et al.'",
      "label": "First Author et al."
    },
    {
      "name": "year",
      "type": "string",
      "nullable": false,
      "description": "Publication year.",
      "label": "Year"
    },
    {
      "name": "journal",
