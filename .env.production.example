# ── Backend production environment (Render / Railway) ──────────────────────
# Set these as environment variables in your host's dashboard. NONE of these
# are exposed to the browser — they live only on the backend.

# Your Gemini API key (used for ALL users). Get one free at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Postgres connection string from Supabase or Neon. The app auto-selects the
# psycopg driver; postgres:// and postgresql:// URLs both work as-is.
# Supabase: Project → Settings → Database → Connection string (URI).
# Neon:     Dashboard → Connection Details → connection string.
#
# IMPORTANT: percent-encode any special characters in the PASSWORD, or URL
# parsing breaks. Most commonly '@' -> '%40'. E.g. a password of  Dl10cj@9031
# must appear in the URL as  Dl10cj%409031 . Other cases: ':' -> '%3A',
# '/' -> '%2F', '#' -> '%23'.
DATABASE_URL=postgresql://user:pass%40word@host:5432/dbname

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Use your deployed frontend URL(s). "*" allows any origin (fine to start).
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Max extractions per browser session per UTC day (protects your Gemini quota).
RATE_LIMIT_PER_DAY=10
